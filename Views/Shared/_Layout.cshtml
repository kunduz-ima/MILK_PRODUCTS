<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MILK_PRODUCTS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MILK_PRODUCTS.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MILK_PRODUCTS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Administrator") || User.IsInRole("Director"))
                            {
                                <!-- Products Dropdown -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark @(User.IsInRole("Director") ? "view-only" : "")"
                                       href="#" id="productsDropdown" role="button" data-bs-toggle="dropdown">
                                        Продукты
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Finproducts" asp-action="Index">Готовые Продукции</a></li>
                                        <li><a class="dropdown-item" asp-controller="Ingredients" asp-action="Index">Ингредиенты</a></li>
                                        <li><a class="dropdown-item" asp-controller="RawMaterials" asp-action="Index">Сырье</a></li>
                                        <li><a class="dropdown-item" asp-controller="Units" asp-action="Index">Единицы измерения</a></li>
                                    </ul>
                                </li>
                                <!-- Operations Dropdown -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark @(User.IsInRole("Director") ? "view-only" : "")"
                                       href="#" id="operationsDropdown" role="button" data-bs-toggle="dropdown">
                                        Операции
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Productions" asp-action="Index">Производство</a></li>
                                        <li><a class="dropdown-item" asp-controller="SaleOfProducts" asp-action="Index">Продажа</a></li>
                                        <li><a class="dropdown-item" asp-controller="PurchaseOfRawMaterials" asp-action="Index">Закупка Сырья</a></li>
                                    </ul>
                                </li>
                                <!-- Staff Dropdown -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark @(User.IsInRole("Director") ? "view-only" : "")"
                                       href="#" id="staffDropdown" role="button" data-bs-toggle="dropdown">
                                        Персонал
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Employees" asp-action="Index">Сотрудники</a></li>
                                        <li><a class="dropdown-item" asp-controller="Positions" asp-action="Index">Должности</a></li>
                                    </ul>
                                </li>
                                <!-- Finance Dropdown -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark @(User.IsInRole("Director") ? "view-only" : "")"
                                       href="#" id="financeDropdown" role="button" data-bs-toggle="dropdown">
                                        Финансы
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Budgets" asp-action="Index">Бюджет</a></li>
                                        <li><a class="dropdown-item" asp-controller="Credits" asp-action="Index">Кредит</a></li>
                                        <li><a class="dropdown-item" asp-controller="Payments" asp-action="Index">Платежи</a></li>
                                        <li><a class="dropdown-item" asp-controller="Salaries" asp-action="Index">Зарплата</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Technologist"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="techProductsDropdown" role="button" data-bs-toggle="dropdown">
                                        Продукты
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="RawMaterials" asp-action="Index">Сырье</a></li>
                                        <li><a class="dropdown-item" asp-controller="Ingredients" asp-action="Index">Ингредиенты</a></li>
                                        <li><a class="dropdown-item" asp-controller="Units" asp-action="Index">Единицы измерения</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Productions" asp-action="Index">Производство</a>
                                </li>
                            }

                            @if (User.IsInRole("Accountant"))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Budgets" asp-action="Index">Бюджет</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Salaries" asp-action="Index">Зарплата</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Credits" asp-action="Index">Кредит</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Payments" asp-action="Index">Платежи</a></li>
                            }

                            @if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="PurchaseOfRawMaterials" asp-action="Index">Закупки</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="SaleOfProducts" asp-action="Index">Продажи</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Finproducts" asp-action="Index">Готовая продукция</a></li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="navbar-text text-dark me-3">
                                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                                    <button type="submit" class="btn btn-link nav-link text-dark">
                                        <i class="bi bi-box-arrow-right"></i> Выйти
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Войти
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <div class="container">
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                        @TempData["Warning"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>