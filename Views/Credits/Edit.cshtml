@model MILK_PRODUCTS.Models.Credit

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Credit</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="CreditSum" class="control-label"></label>
                <input asp-for="CreditSum" class="form-control" />
                <span asp-validation-for="CreditSum" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataOfReceive" class="control-label"></label>
                <input asp-for="DataOfReceive" class="form-control" />
                <span asp-validation-for="DataOfReceive" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Years" class="control-label"></label>
                <input asp-for="Years" class="form-control" />
                <span asp-validation-for="Years" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AnnualPercent" class="control-label"></label>
                <input asp-for="AnnualPercent" class="form-control" />
                <span asp-validation-for="AnnualPercent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Penalty" class="control-label"></label>
                <input asp-for="Penalty" class="form-control" />
                <span asp-validation-for="Penalty" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <input asp-for="Status" class="form-control" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CreditExpirationDate" class="control-label"></label>
                <input asp-for="CreditExpirationDate" class="form-control" />
                <span asp-validation-for="CreditExpirationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
