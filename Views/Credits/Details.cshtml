@model MILK_PRODUCTS.Models.Credit

@{
    ViewData["Title"] = "Credit Details";
}

<h1>Credit Details #@Model.Id</h1>

<div class="row">
    <div class="col-md-6">
        <h4>Credit Information</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">Credit Sum:</dt>
            <dd class="col-sm-8">@Model.CreditSum</dd>

            <dt class="col-sm-4">Start Date:</dt>
            <dd class="col-sm-8">@Model.DataOfReceive?.ToString("MM/dd/yyyy")</dd>

            <dt class="col-sm-4">Term (years):</dt>
            <dd class="col-sm-8">@Model.Years</dd>

            <dt class="col-sm-4">Interest Rate:</dt>
            <dd class="col-sm-8">@Model.AnnualPercent%</dd>

            <dt class="col-sm-4">Penalty Rate:</dt>
            <dd class="col-sm-8">@Model.Penalty%</dd>

            <dt class="col-sm-4">Status:</dt>
            <dd class="col-sm-8">
                @if (Model.Status == true)
                {
                    <span class="badge bg-success">Closed</span>
                }
                else
                {
                    <span class="badge bg-warning">Active</span>
                }
            </dd>

            <dt class="col-sm-4">Expiration Date:</dt>
            <dd class="col-sm-8">@Model.CreditExpirationDate?.ToString("MM/dd/yyyy")</dd>
        </dl>
    </div>

    <div class="col-md-6">
        <h4>Generate Report</h4>
        <hr />
        <form asp-action="Export" method="post" class="mb-3">
            <input type="hidden" name="creditId" value="@Model.Id" />
            <div class="mb-3">
                <label class="form-label">Select format:</label>
                <select name="exportType" class="form-select">
                    <option value="excel">Excel</option>
                    <option value="word">Word</option>
                    <option value="pdf">PDF</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-download"></i> Download Report
            </button>
        </form>
    </div>
</div>

<h4>Payments</h4>
<hr />

@if (Model.Payments.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var payment in Model.Payments)
            {
                <tr>
                    <td>@payment.PaymentDate?.ToString("MM/dd/yyyy")</td>
                    <td>@payment.Total</td>  @* Используем Total вместо Amount *@
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th>Total:</th>
                <th>@Model.Payments.Sum(p => p.Total)</th>  @* Используем Total *@
            </tr>
        </tfoot>
    </table>
}
else
{
    <p>No payments recorded for this credit.</p>
}

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>