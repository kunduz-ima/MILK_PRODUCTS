@model IEnumerable<MILK_PRODUCTS.Models.Budget>

@{
    ViewData["Title"] = "Index";
}

<h1>Бюджет</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BudgetAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SalePercentage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BonusPercentage)
            </th>
            <th></th> 
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.BudgetAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SalePercentage)
            </td>
               <td>
                @Html.DisplayFor(modelItem => item.BonusPercentage)
                </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
